; GSignalX Service — Scale Medium (V2.15 Memory Scale)
; Target: 12–20 symbols (FX+CMD+CR). Same roster as Multisymbol preset.
; Attach: Navigator → Services → GsignalX_Service

InpSymbolList=EURUSD,GBPUSD,USDJPY,AUDUSD,XAUUSD,XAGUSD,USOIL,UKOIL,BTCUSD,ETHUSD,XRPUSD,LTCUSD
InpTimeframe=5
InpScaleProfile=2
InpCycleMs=200
InpRespectChartRunState=true
InpEngineBudgetPerCycle=4
InpFleetEnable=true
InpFleetTargetPairs=4
InpFleetFillCooldownSec=10
InpMode=0
InpTrigPP=true
InpTrigST=false
InpTrigSBT=true
InpMinAgree=2
InpEvalClosedBar=true
InpEntryMode=3
InpOffsetUnit=0
InpLimitOffset=5
InpStopOffset=5
InpPendFromSignalOpen=true
InpPendMaxAgeMin=240
InpStrategicStopEnable=true
InpStrategicStopMult=4.0
InpFlipWaitDefault=false
InpRiskMode=1
InpRiskPct=1.0
InpFixedLot=0.01
InpMaxLot=5.0
InpAutoLotDefault=false
InpMaxSpreadPt=40
InpMagic=20260904
InpLookback=400
InpComment=GsignalX-Svc
InpBusEnable=true
InpBusFullSyncSec=10
InpVerboseSignals=false
InpPropEnable=true
InpPropMaxEquityDdPct=5.0
